# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=roomie:

# Socket.io
SOCKET_PING_INTERVAL_MS=20000
SOCKET_PING_TIMEOUT_MS=20000

# Room rules
ROOM_MAX_MEMBERS=16
ROOM_INACTIVE_TTL_SECONDS=3600
PRESENCE_TTL_SECONDS=45
RECONNECT_GRACE_SECONDS=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Logging
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://roomie:roomie@localhost:5432/roomie
PG_POOL_MAX=10

# JWT - generate strong random secrets for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-please
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-please
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=roomie-backend

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# OAuth - Apple ("Sign in with Apple")
APPLE_CLIENT_ID=com.yourcompany.roomie
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Argon2id password hashing tunables (defaults are OWASP-recommended baseline)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Agora (voice chat) - get these from https://console.agora.io
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_TOKEN_TTL_SECONDS=3600
