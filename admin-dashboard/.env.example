# The dashboard talks to the backend via a Vite dev-server proxy in
# development (see vite.config.js) so no VITE_API_BASE_URL is needed there.
# For a production build served separately from the backend, set this and
# update src/lib/api.js's baseURL accordingly, or serve both behind the
# same reverse proxy (recommended - see backend README for Nginx notes
# added in a later layer).
VITE_API_PROXY_TARGET=http://localhost:4000
